DASHBOARD_DATA_SOURCE=mock
DASHBOARD_PERSON_NAME=Вера
DASHBOARD_GOAL_ID=GOAL-002
DASHBOARD_REFRESH_MS=60000
DASHBOARD_SNAPSHOT_PATH=.data/dashboard-google-snapshot.json
GOOGLE_EXECUTION_SPREADSHEET_ID=
GOOGLE_CONTROL_SPREADSHEET_ID=

# Protected Google Apps Script backend: set DASHBOARD_DATA_SOURCE=apps-script.
# Both values are server/native secrets; rotate them if exposed.
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_ACCESS_TOKEN=
# Optional separate key for signing web login sessions. If empty, APPS_SCRIPT_ACCESS_TOKEN is used.
WEB_SESSION_SECRET=

# Optional legacy read-only /api/assistant route. Task commands use the OpenAI
# service-account key stored in Apps Script Properties, not this local value.
# Server only. Never add NEXT_PUBLIC_ to these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GOOGLE_MASTER_PROMPT_DOCUMENT_ID=1_EBiiqM_7c0FxpXbmfZpAg1-POaftWRm26EIvSflwJk
GOOGLE_WIDGET_BRIEF_DOCUMENT_ID=1PKxVgMn7NyL0Kn55WPsODdMK8Fu_IibHsnH5Nv3A0u8
GOOGLE_DRIVE_ROOT_FOLDER_ID=1X4Qe4giI3mEnPUZTce_Q1aDSCh18P6q_

# Choose one auth method for DASHBOARD_DATA_SOURCE=google.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
